# Copy this file to .env.local for local development. Real values go in
# Vercel's Project Settings → Environment Variables for production — never
# commit actual secrets to this repo.

# ── Email (Resend) — already used by /api/contact and /api/prayer ─────────
RESEND_API_KEY=

# ── Connect Card (/connect, /api/connect-card) ─────────────────────────────
# Where staff notification emails are sent.
CONNECT_CARD_EMAIL_TO=
# Sender address — must be at a domain verified in Resend. Falls back to the
# SENDER constant in src/lib/email.ts if unset.
CONNECT_CARD_EMAIL_FROM=
# Slack incoming webhook URL for staff notifications. Keep this secret —
# never expose it in client code, logs, or committed files.
SLACK_CONNECT_CARD_WEBHOOK_URL=
# Set to "true" to send visitors an automatic thank-you email when they
# provide an email address. Defaults to off.
CONNECT_CARD_SEND_AUTOREPLY=false

# ── Breeze ChMS integration (optional — stays fully disabled until set) ────
# Master switch. Leave unset/false until the steps in CONNECT-CARD.md are
# complete — matching, tagging, and family-linking behavior must be tested
# before this goes to "true" in production.
BREEZE_ENABLED=false
# Your Breeze account subdomain, e.g. "elmwoodbaptist" for
# https://elmwoodbaptist.breezechms.com
BREEZE_SUBDOMAIN=
# Generated by a Breeze administrator under Settings → Extensions → API.
# Keep this secret.
BREEZE_API_KEY=
# Breeze tag IDs (from Breeze → People → Tags). See CONNECT-CARD.md for how
# to find these. Only assigned — never used to downgrade an existing status.
BREEZE_CONNECT_CARD_TAG_ID=
BREEZE_FIRST_TIME_VISITOR_TAG_ID=
BREEZE_RETURNING_VISITOR_TAG_ID=
BREEZE_REGULAR_ATTENDER_TAG_ID=
BREEZE_MEMBER_TAG_ID=
# JSON object mapping Connect Card fields to this Breeze account's specific
# profile-field IDs and multiple-choice option IDs. See CONNECT-CARD.md for
# the exact shape and how to retrieve these values via GET /api/profile.
# Leave empty/unset to leave those fields unsynced.
BREEZE_PROFILE_FIELD_MAP=

# ── Site ────────────────────────────────────────────────────────────────
# Used in the visitor auto-reply email. Defaults to the current site URL if unset.
SITE_URL=https://elmwoodbaptist.elijahdesent.com
